# Svashta Home — root .htaccess
# Kalau di server udah ada .htaccess lain di sini (dari hosting/cPanel default),
# GABUNGIN isi file ini ke situ — jangan ditimpa total.

RewriteEngine On

# Paksa selalu ke "svashtahome.com" (tanpa www) — biar gak ada 2 versi domain yang
# bisa beda kelakuan (misal user buka dari www.svashtahome.com lewat in-app browser
# IG/FB terus asset/CSS-nya kacau). Ini jalan paling pertama, sebelum rule lain.
RewriteCond %{HTTP_HOST} ^www\.svashtahome\.com$ [NC]
RewriteRule ^(.*)$ https://svashtahome.com/$1 [L,R=301]

# /sitemap.xml -> sitemap.php (biar URL-nya rapi, sesuai konvensi search engine)
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# /robots.txt -> robots.php (dinamis, nyesuain staging vs domain asli)
RewriteRule ^robots\.txt$ robots.php [L]

# --- URL rapi (SEO-friendly), gak nunjukin /pages/ atau .php ---
RewriteRule ^product/?$ pages/category.php [L]
RewriteRule ^product/kategori/([^/]+)/?$ pages/category.php?cat=$1 [L,QSA]
RewriteRule ^product/([^/]+)/?$ pages/product.php?slug=$1 [L,QSA]

RewriteRule ^projects/?$ pages/projects-list.php [L]
RewriteRule ^projects/([^/]+)/?$ pages/project-single.php?slug=$1 [L,QSA]

RewriteRule ^blog/?$ pages/blog.php [L]
RewriteRule ^blog/([^/]+)/?$ pages/blog-single.php?slug=$1 [L,QSA]

# /custom-order -> nama baru /consultation. Redirect 301 permanen biar link lama
# (yang udah ke-share/ke-index Google) gak putus, cuma pindah ke URL baru.
RewriteRule ^custom-order/?$ /consultation [R=301,L]
RewriteRule ^consultation/?$ pages/custom_order.php [L]
